DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=inno_track
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Recuperacion de contrasena: URL publica del frontend y vigencia del enlace.
FRONTEND_URL=http://localhost:8080
PASSWORD_RESET_TIMEOUT_SECONDS=1800

# Correo saliente. Con el backend de consola los correos se imprimen en la
# terminal del servidor. Para enviarlos de verdad, usa el backend SMTP y
# completa los datos de tu proveedor de correo.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=INNO-TRACK <no-reply@example.com>