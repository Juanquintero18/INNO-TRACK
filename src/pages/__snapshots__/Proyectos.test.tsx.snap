        </span>
      </label>
      <input
        class="bg-background border border-input disabled:cursor-not-allowed disabled:opacity-50 file:bg-transparent file:border-0 file:font-medium file:text-foreground file:text-sm flex focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring h-10 md:text-sm placeholder:text-muted-foreground px-3 py-2 ring-offset-background rounded-md text-base w-full"
        id="order_codigo"
        placeholder="ORD-0001"
        value=""
      />
    </div>
    <div
      class="gap-4 grid grid-cols-1 sm:grid-cols-2"
    >
      <div
        class="space-y-2"
      >
        <label
          class="font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-sm"
          for="order_fecha"
        >
          Fecha de creacion
        </label>
        <input
          class="bg-background border border-input disabled:cursor-not-allowed disabled:opacity-50 file:bg-transparent file:border-0 file:font-medium file:text-foreground file:text-sm flex focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring h-10 md:text-sm placeholder:text-muted-foreground px-3 py-2 ring-offset-background rounded-md text-base w-full"
          id="order_fecha"
          type="date"
          value=""
        />
      </div>
      <div
        class="space-y-2"
      >
        <label
          class="font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-sm"
        >
          Estado
        </label>
        <button
          aria-autocomplete="none"
          aria-controls="radix-:id:"
          aria-expanded="false"
          class="[&>span]:line-clamp-1 bg-background border border-input disabled:cursor-not-allowed disabled:opacity-50 flex focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ring h-10 items-center justify-between placeholder:text-muted-foreground px-3 py-2 ring-offset-background rounded-md text-sm w-full"
          data-state="closed"
          dir="ltr"
          role="combobox"
          type="button"
        >
          <span
            style="pointer-events: none;"
          >
            Abierta
          </span>
          <svg
            aria-hidden="true"
            class="h-4 lucide lucide-chevron-down opacity-50 w-4"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="m6 9 6 6 6-6"
            />
          </svg>
        </button>
        <select
          aria-hidden="true"
          style="position: absolute; border: 0px; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; word-wrap: normal;"
          tabindex="-1"
        >
          <option
            selected=""
            value="abierta"
          >
            Abierta
          </option>
          <option
            value="en_proceso"
          >
            En proceso
          </option>
          <option
            value="cerrada"
          >
            Cerrada
          </option>
          <option
            value="cancelada"
          >
            Cancelada
          </option>
        </select>
      </div>
    </div>
    <div
      class="flex gap-2 justify-end"
    >
      <button
        class="[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg]:size-4 bg-background border border-input disabled:opacity-50 disabled:pointer-events-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring font-medium gap-2 h-10 hover:bg-accent hover:text-accent-foreground inline-flex items-center justify-center px-4 py-2 ring-offset-background rounded-md text-sm transition-colors whitespace-nowrap"
        type="button"
      >
        Cancelar
      </button>
      <button
        class="[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg]:size-4 bg-primary disabled:opacity-50 disabled:pointer-events-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring font-medium gap-2 h-10 hover:bg-primary/90 inline-flex items-center justify-center px-4 py-2 ring-offset-background rounded-md text-primary-foreground text-sm transition-colors whitespace-nowrap"
        type="submit"
      >
        Guardar
      </button>
    </div>
  </form>
  <button
    class="absolute data-[state=open]:bg-accent data-[state=open]:text-muted-foreground disabled:pointer-events-none focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ring hover:opacity-100 opacity-70 right-4 ring-offset-background rounded-sm top-4 transition-opacity"
    type="button"
  >
    <svg
      class="h-4 lucide lucide-x w-4"
      fill="none"
      height="24"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M18 6 6 18"
      />
      <path
        d="m6 6 12 12"
      />
    </svg>
    <span
      class="sr-only"
    >
      Close
    </span>
  </button>
</div>
`;

