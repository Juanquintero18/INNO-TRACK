      class="bg-muted/20 border p-4 rounded-lg space-y-4"
    >
      <div
        class="gap-3 grid sm:grid-cols-3"
      >
        <div
          class="bg-background border p-3 rounded-lg"
        >
          <p
            class="text-muted-foreground text-xs tracking-wide uppercase"
          >
            Filas totales
          </p>
