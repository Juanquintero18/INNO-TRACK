  role="dialog"
  style="pointer-events: auto;"
  tabindex="-1"
>
  <div
    class="flex flex-col sm:text-left space-y-1.5 text-center"
  >
    <h2
      class="font-semibold leading-none text-lg tracking-tight"
      id="radix-:id:"
    >
      Importar Excel de trabajadores
    </h2>
    <p
      class="text-muted-foreground text-sm"
      id="radix-:id:"
    >
      Sube un archivo .xlsx, .xls o .csv, revisa la vista previa y confirma la importación solo cuando no haya errores.
    </p>
  </div>
  <form
    class="space-y-4"
  >
    <div
      class="bg-emerald-50/50 border border-dashed border-emerald-200 p-4 rounded-lg"
    >
      <p
        class="font-medium text-emerald-950 text-sm"
      >
        Recomendación antes de importar
      </p>
      <p
        class="leading-6 mt-1 text-muted-foreground text-sm"
      >
        Usa una sola tabla por hoja, encabezados claros y evita filas vacías, celdas combinadas o datos ambiguos.
      </p>
      <button
        class="[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg]:size-4 bg-background border border-emerald-200 disabled:opacity-50 disabled:pointer-events-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring font-medium gap-2 h-10 hover:bg-emerald-100 hover:text-accent-foreground inline-flex items-center justify-center mt-3 px-4 py-2 ring-offset-background rounded-md text-emerald-800 text-sm transition-colors whitespace-nowrap"
        type="button"
      >
        <svg
          class="h-4 lucide lucide-download mr-2 w-4"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
