        <span
          class="text-primary"
        >
          *
        </span>
      </label>
      <button
        aria-autocomplete="none"
        aria-controls="radix-:id:"
        aria-expanded="false"
        class="[&>span]:line-clamp-1 bg-background border border-input disabled:cursor-not-allowed disabled:opacity-50 flex focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ring h-10 items-center justify-between placeholder:text-muted-foreground px-3 py-2 ring-offset-background rounded-md text-sm w-full"
        data-placeholder=""
        data-state="closed"
        dir="ltr"
        role="combobox"
        type="button"
      >
        <span
          style="pointer-events: none;"
        >
          Selecciona una unidad
        </span>
        <svg
          aria-hidden="true"
          class="h-4 lucide lucide-chevron-down opacity-50 w-4"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="m6 9 6 6 6-6"
          />
        </svg>
      </button>
      <select
        aria-hidden="true"
        style="position: absolute; border: 0px; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; word-wrap: normal;"
        tabindex="-1"
      >
        <option
          value="1"
        >
          Kilogramo (kg)
        </option>
        <option
          value="2"
        >
          Litro (L)
        </option>
        <option
          value="3"
        >
          Unidad (ud)
        </option>
      </select>
    </div>
    <div
      class="space-y-2"
    >
      <label
        class="font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-sm"
        for="costo"
      >
