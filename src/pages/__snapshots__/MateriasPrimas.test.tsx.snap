exports[`Materias primas > valida y crea una materia prima > dialogo vacio 1`] = `
<div
  aria-describedby="radix-:id:"
  aria-labelledby="radix-:id:"
  class="bg-background border data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:slide-out-to-left-1/2 data-[state=closed]:slide-out-to-top-[48%] data-[state=closed]:zoom-out-95 data-[state=open]:animate-in data-[state=open]:fade-in-0 data-[state=open]:slide-in-from-left-1/2 data-[state=open]:slide-in-from-top-[48%] data-[state=open]:zoom-in-95 duration-200 fixed gap-4 grid left-[50%] max-w-lg p-6 shadow-lg sm:rounded-lg top-[50%] translate-x-[-50%] translate-y-[-50%] w-full z-50"
  data-state="open"
  id="radix-:id:"
  role="dialog"
  style="pointer-events: auto;"
  tabindex="-1"
>
  <div
    class="flex flex-col sm:text-left space-y-1.5 text-center"
  >
    <h2
      class="font-semibold leading-none text-lg tracking-tight"
      id="radix-:id:"
    >
      Nueva materia prima
    </h2>
  </div>
