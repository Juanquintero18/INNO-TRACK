        >
          Administrador
        </option>
        <option
          value="almacenista"
        >
          Almacenista
        </option>
        <option
          selected=""
          value="trabajador"
        >
          Trabajador
        </option>
      </select>
    </div>
    <div
      class="flex gap-2 justify-end"
    >
      <button
        class="[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg]:size-4 bg-background border border-input disabled:opacity-50 disabled:pointer-events-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-ring font-medium gap-2 h-10 hover:bg-accent hover:text-accent-foreground inline-flex items-center justify-center px-4 py-2 ring-offset-background rounded-md text-sm transition-colors whitespace-nowrap"
        type="button"
